---
const { title } = Astro.props;
import Logo from '../components/Logo.astro';

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
      body {
        font-family: 'Inter', Arial, sans-serif;
        margin: 0;
        background: #ffffff;
        color: #222;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      /* HEADER */
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 0;
      }

      .logo img {
        height: 50px;
      }

      nav a {  
        margin-left: 2rem;  
        text-decoration: none;  
        color: #222;  
        font-size: 1.05rem;
    }
    
    nav a.active {  
        font-weight: 600;
    }

      nav a:hover {
        color: #222;
        text-decoration: underline; 
      }

      /* HOMEPAGE */
      
    :global(.home) {
  max-width: 650px;
  margin: 0 auto;
}

:global(.home h1),
:global(.page h1) {
  text-align: center;
  font-size: 2.5rem;   
  font-weight: 500;     
  margin-top: 0.5rem;  
  margin-bottom: 1rem;  
  letter-spacing: -0.5px;
}

:global(.home img),
:global(.page img) {
  display: block;
  margin: 2rem auto;   
}

:global(.home p){
    margin: 2rem auto;     
    line-height: 2;        
    font-size: 1.1rem;     
    text-align: center;  
    max-width: 800px;
}

:global(.page p) {
    margin: 2rem auto;    
    line-height: 2;         
    font-size: 1.1rem;     
    text-align: center;  
    max-width: 800px;
}

:global(.page) {
  max-width: 800px;
  margin: 0 auto;
}

      /* LINKS */
      :global(a) {
        color: #3a6fb0;
        text-decoration: none;
      }

      :global(a:hover) {
        color: #2a76c6;
        text-decoration: underline;
      }

      :global(a:visited) {  
        color: #568bcb;
    }

      /* FOOTER */
      .connect {
        text-align: center;
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 1px solid #eee;
        font-size: 0.95rem;
      }

      .connect a {
        color: #222;
      }

      .connect a:visited {  
        color: #222;
      }

      .connect a:hover {
        text-decoration: underline;
      }

      main {  
        margin-top: 2rem;
        display: flex;  
        align-items: center;  
        flex-direction: column;
        padding: 2rem 0;
    }

@media (max-width: 600px) {
  header {    
    flex-direction: column;    
    align-items: center;  
  }  

    nav {    
      margin-top: 0.5rem;  
    }  

      nav a {    
        margin: 0 0.75rem;    
        font-size: 1rem;
  }

  @media (max-width: 600px) {  
    :global(.home h1),  
    :global(.page h1) {    
    font-size: 2rem;  
  }
}

@media (max-width: 600px) {  
  main {    
    padding: 1.5rem 1rem;  
  }  

:global(.home p),  
:global(.page p) {    
  font-size: 1rem;    
  line-height: 1.9;  
}
}

@media (max-width: 600px) {  
  :global(.home img),  
  :global(.page img) {    
    width: 160px;    
    height: auto;  
  }
}

@media (max-width: 600px) {  
  header {    
    padding: 1rem 0;  
  }  

:global(.home h1),  
:global(.page h1) {    
  margin-top: 1rem;    
  margin-bottom: 1rem;  
}
}
}

    </style>

<script data-goatcounter="https://helenramsay.goatcounter.com/count"
        data-goatcounter-settings='{"no_on_localhost": true, "no_on_dev": true}'
        async src="//gc.zgo.at/count.js"></script>

  </head>

  <body>
    <div class="container">

      <header>
        <div class="logo">
        <Logo />
     </div>

        <nav>  
            <a href="/about" class={currentPath === "/about" ? "active" : ""}>    
                About  
            </a>  
           
            <a href="https://scholar.google.com/citations?user=M0JbSRQAAAAJ&hl=en" target="_blank">    
                Research ↗  
            </a>  
            
            <a href="/links" class={currentPath === "/links" ? "active" : ""}>    
                Links  
            </a>
        </nav>

      </header>

      <main>  
        <slot />
    </main>

      <footer class="connect">
        <p>
          <a href="mailto:hramsay.contact@gmail.com" target="_blank">Email</a>
          &nbsp;·&nbsp;
          <a href="https://www.linkedin.com/in/ramsayhelen/" target="_blank">LinkedIn</a>
        </p>

        <p style="font-size:0.8rem; margin-top:2rem;">
    © {new Date().getFullYear()} Helen Ramsay
  </p>
      </footer>

    </div>
  </body>
</html>